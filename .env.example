# Layer Studios Production Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Database Connection (PostgreSQL on Render / Neon / Supabase, or SQLite fallback)
DATABASE_URL=postgresql://user:password@hostname:5432/layerstudios_db

# Application Configuration
PORT=8080
BASE_URL=https://layerstudios.onrender.com
SECRET_KEY=your_random_secret_session_key_here

# Server-Side Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password_here

# Stripe Payment Gateway (Test Mode / Live Mode)
# Obtain from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Optional: Transactional Email Service (SMTP or Provider API)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@layerstudios.pt
SMTP_PASS=your_smtp_password_here
ALERT_EMAIL=contact@layerstudios.pt
